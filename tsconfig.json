{
   "compilerOptions": {
      "module": "Node16",
      "target": "ES2022",
      "lib": ["ES2022"],
      "sourceMap": true,
      "rootDir": "src",
      "outDir": "dist",
      "strict": true,
      "moduleResolution": "Node16",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true
   },
   "exclude": ["node_modules", ".vscode-test", "dist", "out"]
}
